# ---------------------------------------------------------------------------
# rustiflow-vwall — central configuration
#
# Every script (bootstrap.sh, preflight.sh) and the justfile source this file.
# Edit here, not in the scripts.
# ---------------------------------------------------------------------------

# --- This harness repo (what the nodes clone at swap-in) -------------------
# MUST be reachable from the nodes. Push this repo somewhere public (or a
# gitlab.ilabt mirror) and point the rspec + this URL at it.
VWALL_REPO="https://github.com/lbarraga/rustiflow-oom-vwall-test.git"
VWALL_DIR="/local/rustiflow-oom-vwall-test"

# --- RustiFlow source to build on the nodes --------------------------------
# The RustiFlow *revision* is pinned in flake.lock (the `rustiflow` input), NOT
# here. To change it:  nix flake update rustiflow  (or edit the input url in
# flake.nix and re-lock), then commit flake.lock. RUSTIFLOW_DIR is just where
# bootstrap.sh copies the pinned source to build it.
RUSTIFLOW_DIR="/local/RustiFlow"

# --- Experiment link (must match rspec/preflight.rspec) --------------------
VICTIM_IP="10.0.1.1"
ATTACKER_IP="10.0.1.2"
LINK_GBPS="1"

# --- Smoke-test thresholds -------------------------------------------------
MIN_KERNEL="5.8"        # RustiFlow eBPF ring buffers need >= 5.8
MIN_IPERF_MBIT="850"    # ~1 Gbps minus TCP/framing overhead
CAP_SECS="15"           # rustiflow live-capture window (deploy proof)

# --- Provisioning bookkeeping ----------------------------------------------
# Written by bootstrap.sh so `just wait` / preflight can tell when a node is ready.
MARKER_DIR="/local/rustiflow-oom-vwall-test-state"

# --- Optional: persistent results on the vwall project NFS share -----------
# Leave blank to auto-discover the mounted project share (/groups/* or /proj/*).
# Set explicitly to override. Results land in <share>/rustiflow-oom/<experiment>/.
SHARED_DIR=""

# --- OOM experiment --------------------------------------------------------
# Runs automatically after both nodes reach READY (launched by bootstrap).
RUN_EXPERIMENT=1            # 1 = auto-run the OOM experiment at swap-in; 0 = skip
# Feature set: basic | cic | cidds | nfstream | rustiflow. Overridable from the
# environment so you can re-run a slice with a different set without editing here:
#   sudo bash -c 'export EXP_FEATURES=rustiflow; ./experiment/run-experiment.sh victim ...'
# Each feature set writes to its own results subdir, so runs don't clobber.
EXP_FEATURES="${EXP_FEATURES:-basic}"
EXP_MAX_SECONDS=900         # hard cap: stop even if the victim never OOMs
VICTIM_SAMPLE_SEC="0.1"     # RF RSS / system-memory sampling period (seconds)
NIC_SAMPLE_EVERY=10         # sample NIC ethtool stats every Nth tick (cheaper)

# Flood generator (attacker, pktgen). Randomised src IP + src/dst port => a huge
# unique-5-tuple space so RustiFlow's flow table grows without bound.
FLOOD_PKT_SIZE=60           # 60 => 64B on the wire (max pps)
FLOOD_THREADS=4             # pktgen kernel threads (CPU cores)
FLOOD_SRC_MIN="10.0.0.0"    # random source-IP range (spoofed; L2-delivered)
FLOOD_SRC_MAX="10.255.255.255"
