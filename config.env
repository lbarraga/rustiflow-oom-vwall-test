# Wiring shared by bootstrap.sh, lib.sh and run-experiment.sh. These are paths and
# addresses that must match experiment.rspec — not experiment knobs.
VWALL_DIR="/local/rustiflow-oom-vwall-test"        # where the rspec clones this repo
RUSTIFLOW_DIR="/local/RustiFlow"                   # where RustiFlow is built
MARKER_DIR="/local/rustiflow-oom-vwall-test-state" # provisioning status files
VICTIM_IP="10.0.1.1"
ATTACKER_IP="10.0.1.2"
MIN_KERNEL="5.8"                                   # RustiFlow eBPF ring buffers need >= 5.8
